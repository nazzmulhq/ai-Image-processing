# Copy to .env and fill in. Never commit .env.

LOG_LEVEL=INFO
# Extra browser origins allowed to call the API (the built-in page at / needs none).
CORS_ALLOWED_ORIGINS=
# Serve the web UI at /. Set false for API-only deployments.
SERVE_FRONTEND=true
# Private scratch space for uploads while they are processed. Emptied after every request.
TEMP_DIR=tmp/imgproc

# --- Google Gemini ----------------------------------------------------------------------------
# Server-side only; never sent to the browser. Empty disables detection and AI editing.
GEMINI_API_KEY=AIzaSyDDwZTy2OasPaxRSO9Ud_pMxwFksDHFxY4
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Image edit model for ai_edit_prompt / remove_background. Empty disables AI editing.
GEMINI_IMAGE_EDIT_MODEL=
GEMINI_DETECTION_TIMEOUT_SECONDS=60
GEMINI_EDIT_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=3
# Max simultaneous Gemini calls per server process (protects your quota).
GEMINI_MAX_CONCURRENCY=4

# --- Image limits -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_PIXELS=40000000
MAX_OUTPUT_DIMENSION=8192
# The processed image is returned inside the JSON response, so it must fit this limit.
MAX_OUTPUT_BYTES=15728640
DEFAULT_QUALITY=85

# --- Concurrency and limits (per server process) ---------------------------------------------
# Pillow worker processes (defaults to the number of CPUs, max 8).
# CPU_WORKERS=4
MAX_CONCURRENT_REQUESTS=16
MAX_CONCURRENT_PER_IP=3
RATE_LIMIT_IP_PER_MINUTE=30
REQUEST_TIMEOUT_SECONDS=150

# --- docker compose ---------------------------------------------------------------------------
# Proxy IPs whose X-Forwarded-For is trusted (per-IP limits behind a load balancer).
FORWARDED_ALLOW_IPS=127.0.0.1
